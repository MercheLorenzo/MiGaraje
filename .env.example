# PostgreSQL
POSTGRES_DB=migaraje
POSTGRES_USER=migaraje
POSTGRES_PASSWORD=change_me_locally

# ==================================================
# Database URLs
# Use the same credentials as PostgreSQL.
# Each microservice has its own database.
# ==================================================

# Original database (legacy / backup)
DATABASE_URL=postgresql+psycopg://migaraje:change_me_locally@db:5432/migaraje

# Vehicles service
VEHICLES_DATABASE_URL=postgresql+psycopg://migaraje:change_me_locally@db:5432/migaraje_vehicles

# Maintenance service
MAINTENANCE_DATABASE_URL=postgresql+psycopg://migaraje:change_me_locally@db:5432/migaraje_maintenance

# Maintenance planning service
PLANNING_DATABASE_URL=postgresql+psycopg://migaraje:change_me_locally@db:5432/migaraje_planning

# ==================================================
# Internal service communication
# Docker Compose service names must be used here.
# ==================================================

# Vehicles service
VEHICLES_SERVICE_URL=http://vehicles-service:8000

# Maintenance planning service
PLANNING_SERVICE_URL=http://maintenance-planning-service:8002
